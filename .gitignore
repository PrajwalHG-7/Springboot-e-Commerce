# ============================================================
# Spring Boot / Application
# ============================================================

# ------------------------------------------------------------
# Local Spring Boot configuration
# Ignore application.properties in EVERY module/microservice
# ------------------------------------------------------------

**/src/main/resources/application.properties

# Spring profile-specific local configurations
**/src/main/resources/application-local.properties
**/src/main/resources/application-dev.properties
**/src/main/resources/application-test.properties
**/src/main/resources/application-prod.properties

# Also ignore profile configs if they exist outside the
# conventional src/main/resources location
application-local.properties
application-dev.properties
application-test.properties
application-prod.properties

# ------------------------------------------------------------
# Optional: Ignore all Spring Boot local config variants
# Uncomment if you use additional profiles such as staging,
# docker, qa, etc.
# ------------------------------------------------------------

# **/src/main/resources/application-*.properties

